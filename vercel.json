{
  "functions": {
    "api/*.js": {
      "includeFiles": "server/**",
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/server/:path*",
      "destination": "/api/not-found"
    },
    {
      "source": "/supabase/:path*",
      "destination": "/api/not-found"
    },
    {
      "source": "/tests/:path*",
      "destination": "/api/not-found"
    }
  ]
}
